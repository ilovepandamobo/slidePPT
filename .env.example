# 数据库（本地 SQLite；云端建议挂载卷后使用 file:/data/slidecraft.db）
DATABASE_URL="file:./prisma/dev.db"

# 会话密钥（生产环境务必改为随机长字符串）
JWT_SECRET="请替换为随机密钥"

# 站点公网地址（分享链接、参考图公网 URL 依赖此项）
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- 推荐：乘丰 2 个 key + GrsAI 1 个 key ---
# 高清 4K：先乘丰双账号分流 → 仍失败再用 GrsAI 同一 key 做 images/generations 4K
# 标准画质：仅 GrsAI Draw（GRSAI_API_KEY），不走乘丰

# GrsAI（grsai.dakka.com.cn）— 通常只配一个 key
GRSAI_API_KEY=""
GRSAI_BASE_URL="https://grsai.dakka.com.cn"
GRSAI_MODEL="gpt-image-2"
GRSAI_CHAT_MODEL="gemini-3.5-flash"
# 可选第二 GrsAI key（多数用户留空即可）
# GRSAI_API_KEY_2=""
# GRSAI_API_KEYS="sk-a,sk-b"

# 乘丰 Feng（api.cphone.vip）— 高清 4K 优先，建议两个 key 分流
GRSAI_IMAGES_API_KEY=""
GRSAI_IMAGES_API_KEY_2=""
# 或逗号分隔多个：GRSAI_IMAGES_API_KEYS="sk-a,sk-b"
GRSAI_IMAGES_BASE_URL="https://api.cphone.vip"
GRSAI_IMAGES_MODEL="gpt-image-2-vip"
# GRSAI_IMAGES_TIMEOUT_MS=540000

# 乘丰 4K 失败时：GrsAI 同格式 POST /v1/images/generations（GRSAI_API_KEY + GRSAI_BASE_URL）
# 高清默认单页串行；批量可设 GENERATION_CONCURRENCY=2（不建议更大）
# GRSAI_IMAGES_FALLBACK_BASE_URL="https://grsaiapi.com"
# FENG_IMAGES_RETRIES=2

# 可选：OpenAI 大纲助手 / DALL·E 备用
OPENAI_API_KEY=""

# 可选：生成并发与轮询
# GENERATION_CONCURRENCY=3
# GRSAI_POLL_ATTEMPTS=180
# GRSAI_GENERATE_RETRIES=1

# Docker 首次启动是否写入演示账号（demo@slidecraft.app / demo123456）
# RUN_SEED="true"
